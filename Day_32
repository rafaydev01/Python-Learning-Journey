print("--- START OF CHAPTER 2 DEMO ---")

# Step 1: String Concatenation and Length Calculation
first_part = "Welcome to Python, "
full_message = first_part + name  # Joining strings
print("Concatenated String:", full_message)

message_length = len(full_message)
print("Total length of the message string is:", message_length)

print("-------------------------------------------------")

# Step 2: String Indexing and Slicing as explained in the lectures
# Accessing specific characters using indexes
print("First character of the name:", name[0])
print("Last character of the name:", name[-1])

# Slicing the string [start_index : end_index]
sample_str = "ApnaCollegePython"
sliced_part1 = sample_str[0:4]     # Gets "Apna"
sliced_part2 = sample_str[4:11]    # Gets "College"
sliced_part3 = sample_str[11:]     # Gets "Python" (till end)

print("Sliced Part 1:", sliced_part1)
print("Sliced Part 2:", sliced_part2)
print("Sliced Part 3:", sliced_part3)

print("-------------------------------------------------")

# Step 3: Built-in String Functions
story = "rafay loves to code in python. rafay watches apna college daily."

print("Original Story String:", story)
print("Ends with 'daily.'?", story.endswith("daily."))
print("Capitalized First Letter:", story.capitalize())
print("Replaced name:", story.replace("rafay", "Rafay"))
print("Find index of word 'code':", story.find("code"))
print("Count how many times 'rafay' appears:", story.count("rafay"))

print("-------------------------------------------------")

# Step 4: Conditional Statements (if-elif-else) Practice
# Let's run a check system for Rafay's profile grading

marks = 85  # Example score for testing conditionals

print("Evaluating grades for student Rafay based on marks:", marks)

if marks >= 90:
    print("Grade: A+ (Outstanding performance!)")
elif marks >= 80 and marks < 90:
    print("Grade: A (Excellent work, Rafay!)")
elif marks >= 70 and marks < 80:
    print("Grade: B (Good job, keep improving.)")
elif marks >= 33 and marks < 70:
    print("Grade: C (Passed, need more practice.)")
else:
    print("Grade: F (Failed, watch Sharda Didi's videos again.)")

print("-------------------------------------------------")

