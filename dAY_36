# Step 1: Basic While Loop (Iterating with a condition)
# Sharda Didi explained that while loops run as long as the condition is True
print("Printing numbers from 1 to 5 using a While Loop:")
count = 1
while count <= 5:
    print(f"Loop Index Count: {count} | User: Rafay")
    count += 1  # Incrementing the loop variable

print("-------------------------------------------------")

# Step 2: Practical While Loop Examples (Reverse counting & Table generation)
print("Printing a Reverse Countdown (5 down to 1):")
countdown = 5
while countdown >= 1:
    print(f"Countdown: {countdown}")
    countdown -= 1

print("\nGenerating the Multiplication Table of 3 using a loop:")
number = 3
iterator = 1
while iterator <= 10:
    print(f"{number} x {iterator} = {number * iterator}")
    iterator += 1

print("-------------------------------------------------")

# Step 3: Working with Lists in While Loops
print("Iterating through a list using a While Loop:")
fav_topics = ["Variables", "Strings", "Lists", "Tuples", "Dictionaries", "Loops"]
index = 0
total_elements = len(fav_topics)

while index < total_elements:
    print(f"Topic at index {index} is: {fav_topics[index]}")
    index += 1

print("-------------------------------------------------")

# Step 4: Introduction to For Loops (Sequential Traversal)
# For loops are used for iterating over a sequence (list, tuple, string)
print("Traversing the same topics list using a clean For Loop:")
for topic in fav_topics:
    print(f"Current Loop Item: {topic} (Studied by Rafay)")

print("\nTraversing a string character by character:")
for character in "Rafay":
    print(f"Character: {character}")

print("-------------------------------------------------")

# Step 5: The range() Function in For Loops
# range(start, stop, step) - generates a sequence of numbers
print("Using range(stop) -> range(5):")
for i in range(5):  # Starts at 0, ends at 4 (5 is excluded)
    print(f"Value of i: {i}")

print("\nUsing range(start, stop) -> range(10, 15):")
for j in range(10, 15):  # Starts at 10, ends at 14
    print(f"Value of j: {j}")

print("\nUsing range(start, stop, step) -> Even numbers from 2 to 10:")
for k in range(2, 11, 2):  # Steps/skips by 2 numbers
    print(f"Even number: {k}")

print("-------------------------------------------------")

# Step 6: Loop Control Statements (Break & Continue)
print("Testing 'break' statement (Stops the loop completely when condition hits):")
for value in range(1, 10):
    if value == 5:
        print(f"Break condition triggered at value: {value}. Exiting loop!")
        break
    print(f"Processing number: {value}")

print("\nTesting 'continue' statement (Skips the current iteration and goes to next):")
for value in range(1, 6):
    if value == 3:
        print(f"Skipping value {value} using continue statement.")
        continue
    print(f"Printing valid number: {value}")

print("-------------------------------------------------")

# Step 7: Practice Question (Finding a number in a tuple using a loop)
numbers_tuple = (12, 45, 67, 89, 100, 23, 45)
search_target = 89
found = False

print(f"Searching for target number {search_target} inside tuple: {numbers_tuple}")

for idx, num in enumerate(numbers_tuple):
    if num == search_target:
        print(f"Success! Number {search_target} found at index structural position: {idx}")
        found = True
        break

if not found:
    print("Target number was not found in the sequence.")

print("--- END OF CHAPTER 5 DEMO ---")
