print("--- START OF CHAPTER 1 DEMO ---")

# Step 1: Declaring different variable types as taught by Sharda Didi
name = "Rafay"          # String variable
age = 20                # Integer variable
price = 99.99           # Float variable
is_learning = True      # Boolean variable
a = None                # None type variable

# Step 2: Printing the values and their exact data types
print("User Name:", name)
print("Data Type of name is:", type(name))

print("User Age:", age)
print("Data Type of age is:", type(age))

print("Product Price:", price)
print("Data Type of price is:", type(price))

print("Is Rafay learning Python?", is_learning)
print("Data Type of is_learning is:", type(is_learning))

print("Value of a:", a)
print("Data Type of a is:", type(a))

print("-------------------------------------------------")

# Step 3: Arithmetic and Logical Operators Practice
num1 = 500
num2 = 250

# Performing basic calculations
sum_result = num1 + num2
diff_result = num1 - num2
mul_result = num1 * num2
div_result = num1 / num2
modulo_result = num1 % num2

print("Addition Result (500 + 250):", sum_result)
print("Subtraction Result (500 - 250):", diff_result)
print("Multiplication Result (500 * 250):", mul_result)
print("Division Result (500 / 250):", div_result)
print("Remainder/Modulo Result (500 % 250):", modulo_result)

print("-------------------------------------------------")

# Step 4: Relational and Logical Operators
print("Is num1 greater than num2?", num1 > num2)
print("Is num1 equal to num2?", num1 == num2)

# Logical AND/OR conditions
condition1 = (num1 > num2) and (age > 18)
condition2 = (num1 < num2) or (name == "Rafay")

print("Logical AND test result:", condition1)
print("Logical OR test result:", condition2)

print("-------------------------------------------------")

# Step 5: Type Conversion vs Type Casting
# Type Conversion (Automatic by Python)
val1 = 10      # int
val2 = 4.5     # float
final_val = val1 + val2
print("Automatic Type Conversion Result:", final_val, "| Type:", type(final_val))

# Type Casting (Manual conversion by programmer)
string_num = "100"
converted_num = int(string_num)
total_sum = converted_num + 50
print("Manual Type Casting Result:", total_sum)

print("--- END OF CHAPTER 1 DEMO ---\n")


