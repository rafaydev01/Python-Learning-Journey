print("\n--- Lesson 2: Operators & Logic ---")

# Arithmetic Operators
a = 10
b = 5
sum_result = a + b
print("Sum of 10 and 5 is:", sum_result)

# Conditional Statements (if-elif-else)
print("\n--- Checking Conditions ---")
if user_name == "Rafay":
    print("Access Granted. Welcome back, Rafay!")
elif user_name == "Admin":
    print("Welcome, Admin!")
else:
    print("Unknown User.")

# Using Loops to print 'Rafay' multiple times
print("\n--- Printing 'Rafay' 5 times using a For Loop ---")
for i in range(1, 6):
    print(f"{i}. {user_name}")

print("\n--- Printing 'Rafay' using a While Loop ---")
counter = 1
while counter <= 3:
    print("Loop Counter:", counter, "-", user_name)
    counter += 1

