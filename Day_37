# Step 5: Introduction to Recursion (Function calling itself)
# Sharda Didi emphasized that recursion must have a base case to prevent endless loop
print("Using Recursion to print a countdown from 5 to 1:")

def print_countdown_recursive(n):
    # Base Case: Condition where the recursion stops
    if n == 0:
        return
    
    print(f"Recursive State: {n}")
    print_countdown_recursive(n - 1)  # Inner Recursive Call

# Calling the recursive function
print_countdown_recursive(5)

print("-------------------------------------------------")

# Step 6: Classic Recursion Problem (Calculating Factorial)
# Factorial of 5 (5!) = 5 * 4 * 3 * 2 * 1 = 120
def calculate_factorial(n):
    # Base Case
    if n == 0 or n == 1:
        return 1
    # Recursive Case: n * factorial(n-1)
    else:
        return n * calculate_factorial(n - 1)

target_number = 5
factorial_result = calculate_factorial(target_number)
print(f"Mathematical Factorial calculation of {target_number}! is: {factorial_result}")

