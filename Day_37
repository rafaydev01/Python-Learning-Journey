# Step 2: Functions with Parameters and Arguments
# Parameters act as placeholders for data inside functions
def calculate_average(marks_list):
    total_sum = sum(marks_list)
    total_subjects = len(marks_list)
    average = total_sum / total_subjects
    return average  # Returning the calculated value back

# Testing the average function with Rafay's marks
rafay_marks = [85, 92, 78, 90, 88]
calculated_avg = calculate_average(rafay_marks)

print(f"Rafay's Marks List: {rafay_marks}")
print(f"Calculated Average Score: {calculated_avg}")

print("-------------------------------------------------")

